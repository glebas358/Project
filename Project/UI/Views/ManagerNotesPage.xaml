<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project.UI.Views.ManagerNotesPage"
             x:Name="Page"  
             Title="Заметки" BackgroundColor="#0E3255" Shell.TitleColor="#009BAC">
    <Grid RowDefinitions="Auto, *">

       
        <VerticalStackLayout Grid.Row="0" Padding="15" Spacing="10">
            <Editor Placeholder="Напишите заметку..." Text="{Binding NewNoteText}" HeightRequest="100"  TextColor="#CBFAFF" BackgroundColor="#009BAC" PlaceholderColor="#0E3255"/>
            <Button Text="Сохранить заметку" Command="{Binding AddNoteCommand}" BackgroundColor="#009BAC" TextColor="#CBFAFF" />
        </VerticalStackLayout>

        
        <CollectionView Grid.Row="1" ItemsSource="{Binding Notes}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>

                        <SwipeView.RightItems>

                            <SwipeItem Text="Изменить" 
                                           BackgroundColor="#55A0A8"
                                           
                                           Command="{Binding Source={x:Reference Page}, Path=BindingContext.UpdateNoteCommand}" 
                                           CommandParameter="{Binding .}" />

                            <SwipeItem Text="Удалить" 
                                           BackgroundColor="#940E0E" 
                                           Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteNoteCommand}" 
                                           CommandParameter="{Binding .}" />

                        </SwipeView.RightItems>

                        <Frame Padding="15" BorderColor="#0E3255" CornerRadius="10" BackgroundColor="#009BAC" >
                            <VerticalStackLayout>
                                <Label Text="{Binding Text}" TextColor="#CBFAFF"/>
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="12" TextColor="#C9E9ED" />
                            </VerticalStackLayout>
                        </Frame>

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="0" Grid.RowSpan="2" 
           IsVisible="{Binding IsBusy}" 
           BackgroundColor="#99000000" 
           VerticalOptions="Fill" 
           HorizontalOptions="Fill">

            <Frame HorizontalOptions="Center" 
            VerticalOptions="Center" 
            Padding="30" 
            CornerRadius="15" 
            BackgroundColor="#CBFAFF"
            HasShadow="True">       
                <VerticalStackLayout Spacing="15">

                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                        Color="#009BAC" 
                        WidthRequest="50" 
                        HeightRequest="50" />

                    <Label Text="Загрузка..." 
                    TextColor="#009BAC" 
                    HorizontalTextAlignment="Center" 
                    FontAttributes="Bold"/>     
                </VerticalStackLayout>
            </Frame>
        </Grid>







    </Grid>
</ContentPage>