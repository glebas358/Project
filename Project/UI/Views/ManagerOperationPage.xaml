<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project.UI.Views.ManagerOperationPage"
             xmlns:vm="clr-namespace:Project.UI.ViewModels"
             Title="История операций" BackgroundColor="#0E3255" Shell.TitleColor="#009BAC">
    
    <Grid RowDefinitions="Auto, *">
        
        

       
        <VerticalStackLayout Grid.Row="0" Padding="15" Spacing="10" BackgroundColor="#009BAC">
            <Label Text="Фильтр по датам" FontAttributes="Bold" TextColor="#CBFAFF"/>

            <HorizontalStackLayout Spacing="10">
                <Label Text="От:" VerticalOptions="Center" TextColor="#CBFAFF" />
                <DatePicker Date="{Binding FromDate}" Format="dd.MM.yyyy" BackgroundColor="#0E3255" TextColor="#CBFAFF"/>

                <Label Text="До:" VerticalOptions="Center" TextColor="#CBFAFF" />
                <DatePicker Date="{Binding ToDate}" Format="dd.MM.yyyy"  BackgroundColor="#0E3255" TextColor="#CBFAFF"/>
            </HorizontalStackLayout>

            <Button Text="Показать историю" 
                    Command="{Binding LoadHistoryCommand}" 
                    BackgroundColor="#0E3255" 
                    TextColor="#CBFAFF"  />
        </VerticalStackLayout>





        <CollectionView Grid.Row="1" ItemsSource="{Binding Operations}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5,10,10" Padding="15" BorderColor="#0E3255" CornerRadius="10" BackgroundColor="#009BAC"  >
                        <Grid ColumnDefinitions="*, Auto" >

                            <VerticalStackLayout Grid.Column="0" Spacing="5" >

                                <Label Text="{Binding OperationTypeRussian}" FontAttributes="Bold" FontSize="16" TextColor="#CBFAFF" />

                               
                                <Label Text="{Binding Package.Number, StringFormat='Посылка: {0}'}" TextColor="#CBFAFF"/>

                               
                                <Label Text="{Binding Employee.Name, StringFormat='Сотрудник: {0}'}" TextColor="#C9E9ED" />

                               
                                <Label Text="{Binding Timestamp, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="12" TextColor="#C9E9ED" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="0" Grid.RowSpan="2" 
          IsVisible="{Binding IsBusy}" 
          BackgroundColor="#99000000" 
          VerticalOptions="Fill" 
          HorizontalOptions="Fill">

            <Frame HorizontalOptions="Center" 
           VerticalOptions="Center" 
           Padding="30" 
           CornerRadius="15" 
           BackgroundColor="#CBFAFF"
           HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               Color="#009BAC" 
                               WidthRequest="50" 
                               HeightRequest="50" />

                    <Label Text="Загрузка..." 
                   TextColor="#009BAC" 
                   HorizontalTextAlignment="Center" 
                   FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>